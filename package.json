{
  "name": "archive-ly",
  "version": "0.1.0",
  "private": true,
  "description": "Arabic electronic document archiving system",
  "workspaces": ["apps/api", "apps/web"],
  "scripts": {
    "dev": "npm --workspace apps/api run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "start": "npm --workspace apps/api start",
    "test": "npm --workspace apps/api test",
    "build:web": "npm --workspace apps/web run build",
    "db:migrate": "npm --workspace apps/api run db:migrate"
  },
  "engines": { "node": ">=20" }
}
